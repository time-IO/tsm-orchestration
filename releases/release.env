# set datelike _PROD_TAG for each new release
# we need to keep the underscore in this variable,
# otherwise compare_dotenv_files.py registers it 
# as a variable that needs to also exist in .env.example
_PROD_TAG=prod-2026-09-30

# regularly check for updates
OBJECT_STORAGE_MINIO_IMAGE_TAG=RELEASE.2026-09-16T00-00-00Z
MQTT_BROKER_MOSQUITTO_IMAGE_TAG=3.5.0-mosquitto_2.1.2
VISUALIZATION_GRAFANA_IMAGE_TAG=11.6.13
PROXY_NGINX_IMAGE_TAG=1.29.5
MONITORING_CADVISOR_IMAGE_TAG=v0.53.0
MQTT_CAT_MOSQUITTO_IMAGE_TAG=2.0.22
TSMDL_IMAGE_TAG=0.4.0
DB_API_IMAGE_TAG=2026-09-22-092812

# prod-YYYY-mm-dd release tags
DSM_API_IMAGE_TAG=${_PROD_TAG}
DSM_FRONTEND_IMAGE_TAG=${_PROD_TAG}
TIMEIO_CRON_SCHEDULER_IMAGE_TAG=${_PROD_TAG}
TIMEIO_INIT_IMAGE_TAG=${_PROD_TAG}
TIMEIO_FROST_IMAGE_TAG=${_PROD_TAG}
TIMEIO_DISPATCHER_IMAGE_TAG=${_PROD_TAG}
TIMEIO_FLYWAY_IMAGE_TAG=${_PROD_TAG}
TIMEIO_KEYCLOAK_IMAGE_TAG=${_PROD_TAG}
